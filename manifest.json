{
  "manifest_version": 3,
  "name": "VisionEase Accessibility Suite",
  "version": "1.0.0",
  "description": "Deterministic accessibility controls for low vision support. Privacy-focused, local-first.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/accessibility.css"],
      "js": [
        "utils/storage.js",
        "utils/profiles.js",
        "utils/accessibility.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}